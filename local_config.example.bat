@echo off
rem Przykladowa konfiguracja PhotoCraft AI
rem Skopiuj ten plik jako local_config.bat.
rem Zmien ponizsze sciezki zgodnie ze swoja instalacja.
rem Nie umieszczaj hasel ani tokenow w tym pliku.

rem Katalog srodowiska Python z zainstalowanym mcp-proxy
set "OLD=C:\OpenWebUI"

rem Katalog instalacji edytora PhotoCraft
set "PC=C:\Program Files\PhotoCraft"

rem Katalog wymiany plikow z edytorem PhotoCraft
set "IMPORT_DIR=C:\PhotoCraftAI\import"

rem Katalog instalacji ComfyUI Portable
set "COMFY_ROOT=C:\ComfyUI"